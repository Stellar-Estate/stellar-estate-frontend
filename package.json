{
  "name": "@stellar-estate/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "tsc --noEmit",
    "check:env": "node scripts/check-env.mjs",
    "verify:all": "node ../stellar-estate-core/scripts/run-all-checks.mjs",
    "audit:bundle": "node ../stellar-estate-core/scripts/generate-audit-bundle.mjs",
    "verify:submission": "node ../stellar-estate-core/scripts/pre-submission-check.mjs"
  },
  "dependencies": {
    "@stellar/freighter-api": "^3.0.0",
    "@stellar/stellar-sdk": "^13.0.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^8.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.5"
  }
}
